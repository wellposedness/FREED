# When MIPT/entanglement signals co-occur with length-scale divergence signals,
# a bonus is applied.

O112_MIPT_PATTERNS = [
    (r"measurement.induced\s+(phase\s+)?transition", 4),
    (r"localizable\s+entanglement", 5),
    (r"entanglement\s+(entropy|transition|phase)", 3),
